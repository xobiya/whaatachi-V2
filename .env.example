# ── Server ──
PORT=3001
NODE_ENV=development

# ── MySQL (cPanel) ──
DATABASE_URL="mysql://username:password@localhost/whaatachi?schema=public&connection_limit=10"

# ── Authentication ──
JWT_SECRET=<your-jwt-secret-change-this>
ADMIN_PASSCODE=<your-admin-passcode>

# ── CORS ──
CORS_ORIGIN=http://localhost:3000,https://whaatachi.vercel.app

# ── Seed (set to true to seed on first run) ──
RUN_SEED=false
