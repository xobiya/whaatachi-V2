{
  "name": "whaatachi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx server.ts",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run db:generate && vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --external:express --external:@prisma/client --external:cors --external:helmet --external:morgan --external:express-rate-limit --external:bcryptjs --external:jsonwebtoken --external:uuid --external:dotenv",
    "start": "node dist/server.js",
    "start:server": "node dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:generate": "npx prisma generate && node -e \"const fs=require('fs'),s='node_modules/.prisma/client',d='prisma/generated-client';if(!fs.existsSync(d))fs.mkdirSync(d,{recursive:true});fs.cpSync(s,d,{recursive:true})\"",
    "db:migrate": "npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "postinstall": "node -e \"const fs=require('fs'),s='prisma/generated-client',d='node_modules/.prisma/client';if(fs.existsSync(s)){if(!fs.existsSync(d))fs.mkdirSync(d,{recursive:true});fs.cpSync(s,d,{recursive:true});console.log('Prisma Client ready at '+d)}else console.warn('Skip prisma copy: source not found (pull latest code or run npm run db:generate)')\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "morgan": "^1.11.0",
    "motion": "^12.23.24",
    "mysql2": "^3.22.5",
    "prisma": "^6.6.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uuid": "^11.1.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.8"
  }
}
